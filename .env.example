# Copy this file to .env for local development (already gitignored)
# On HF Spaces, set these under Settings → Variables and secrets

# --- Paths (pre-configured in Dockerfile, override only if needed) ---
DATABASE_PATH=/app/data/content_registry.db
UPLOADS_DIR=/app/uploads

# --- CORS ---
# Comma-separated list of allowed origins. Use * to allow all (not for production).
ALLOWED_ORIGINS=*

# --- Public URL (CRITICAL for image paths) ---
# Set this to your HF Spaces URL BEFORE running any /extract calls.
# Without this, extracted image paths will be localhost:8000 links (broken externally).
# Example: https://your-username-content-registry.hf.space
BASE_URL=http://localhost:8000
